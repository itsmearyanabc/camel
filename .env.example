# Database
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"
DIRECT_URL="postgresql://user:password@localhost:5432/dbname"

# Session Security (REQUIRED in production)
# Generate with: openssl rand -base64 32
SESSION_SECRET="your-session-secret-here"

# NextAuth
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Telegram Bot
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_BOT_TOKEN_2="your-second-bot-token"
TELEGRAM_WEBHOOK_SECRET="your-webhook-secret"

# --- Customer-support bot ----------------------------------------------------
# A SEPARATE bot from the shop bot. It shows a menu of common problems, turns
# the customer's answer into a ticket (a Dispute row), and that ticket appears
# in the control panel's Disputes tab for both admins and staff.
#
# Its token MUST NOT be the same as TELEGRAM_BOT_1_TOKEN or TELEGRAM_BOT_2_TOKEN.
# Telegram allows exactly one long-poller per token: sharing one puts two
# pollers on it, they trade 409s, and neither answers. Startup refuses to boot
# the support bot if it detects a shared token — see src/instrumentation.ts.
#
# Leave the token empty and the support bot simply does not run; the site keeps
# working and only the "Chat with Support" link is affected.
TELEGRAM_SUPPORT_BOT_TOKEN="123456:ABC-your-support-bot-token"

# Username of that same bot, used for the "Chat with Support" link on the
# dashboard. Accepts "name", "@name" or "https://t.me/name".
# Leave empty to hide the link.
TELEGRAM_SUPPORT_BOT_USERNAME="camel971_support_bot"

# --- Telegram channel directory ---------------------------------------------
# NOT configured here. Channels are managed by an admin in the control panel
# (Telegram tab) and stored in the Setting table, so publishing one takes
# effect immediately with no restart and no deploy.

# NOWPayments (crypto payment gateway)
# API key: NOWPayments dashboard -> Settings -> Payments -> API keys
NOWPAYMENTS_API_KEY="your-nowpayments-api-key"
# IPN secret: NOWPayments dashboard -> Settings -> Payments -> Instant Payment Notifications
# Both are REQUIRED. If either is missing, crypto checkout falls back to
# manual wallet-address payment instead of the hosted invoice.
NOWPAYMENTS_IPN_SECRET="your-nowpayments-ipn-secret"
# Set to "true" only when testing against https://sandbox.nowpayments.io
# (sandbox uses a completely separate API key AND IPN secret)
NOWPAYMENTS_SANDBOX="false"

# Password Encryption (REQUIRED for admin password recovery)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PASSWORD_ENCRYPTION_KEY="your-64-character-hex-encryption-key-here"

# Cron Job Secret (for securing cron endpoints)
CRON_SECRET="your-cron-secret-here"

# App URL — MUST be the real public https origin in production, no trailing slash.
# This builds the NOWPayments IPN callback URL, so if it is wrong or missing,
# payments will be taken but never confirmed.
#
# Set APP_URL: it has no NEXT_PUBLIC_ prefix, so it is read at runtime and a
# restart is enough. NEXT_PUBLIC_* values are frozen into the bundle at
# `next build` and ignore later edits, so they are only fallbacks here.
APP_URL="https://your-domain.com"
NEXT_PUBLIC_APP_URL="https://your-domain.com"
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# --- Cloudflare Turnstile (bot protection on login + register) ---------------
# Cloudflare dashboard -> Turnstile -> Add widget. Add every hostname the site
# is served on, including "localhost" if you want the widget in `next dev`.
#
# The site key is PUBLIC and is baked into the browser bundle at `next build`.
# Set it BEFORE building on the VPS - editing it afterwards and restarting does
# nothing, because the old value is already compiled in.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAAA-your-site-key"
#
# The secret key is read at runtime, so a restart is enough for this one.
# It NEVER reaches the browser. Never prefix it with NEXT_PUBLIC_.
#
# Leaving the secret empty disables verification and the site keeps working
# (see src/lib/turnstile.ts for why it fails open rather than closed) - the
# server logs a warning once at startup. The rate limiter in src/proxy.ts and
# the account lockout in the login route are unaffected either way.
TURNSTILE_SECRET_KEY="0x4AAAAAAA-your-secret-key"
#
# Cloudflare's always-passes test pair, for local development:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
#   TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
