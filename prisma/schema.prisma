datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String           @id @default(uuid())
  username            String           @unique
  passwordHash        String
  passwordEncrypted   String?          // AES-256-GCM encrypted password (for admin recovery)
  avatarUrl           String?
  telegramUsername    String?
  telegramId          String?          @unique
  role                String           @default("CUSTOMER") // CUSTOMER, STAFF, ADMIN, SUPERADMIN
  failedLoginAttempts Int              @default(0)
  lockUntil           DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  wallet              Wallet?
  orders              Order[]
  disputes            Dispute[]
  depositRequests     DepositRequest[]
  reviews             Review[]
  notifications       Notification[]
}

model Wallet {
  id        String         @id @default(uuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Decimal        @default(0.0) @db.Decimal(12, 2)
  currency  String         @default("USD")
  updatedAt DateTime       @updatedAt
  ledgers   WalletLedger[]

  @@index([userId])
}

model WalletLedger {
  id          String   @id @default(uuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type        String   // DEPOSIT, PURCHASE, REFUND, CREDIT
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("USD")
  description String
  createdAt   DateTime @default(now())

  @@index([walletId])
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  prefixCode  String?   @unique // e.g. 'A', 'B'
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
}

model City {
  id        String    @id @default(uuid())
  name      String    @unique
  areas     Area[]
  products  Product[]
}

model Area {
  id        String    @id @default(uuid())
  name      String
  cityId    String
  city      City      @relation(fields: [cityId], references: [id], onDelete: Cascade)
  products        Product[]
  areaDetails     ProductAreaDetail[]
  orderItems      OrderItem[]
}

model Product {
  id            String          @id @default(uuid())
  categoryId    String?
  category      Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  productType   String?         // Free-text product type (e.g. Powder, Liquid, Capsule)
  name          String          @unique
  description   String?
  price         Decimal         @db.Decimal(12, 2)
  currency      String          @default("USD")
  formula       String?         // Chemical formula (e.g. NaCl, H2SO4)
  casNumber     String?         // CAS Registry Number for chemicals
  imageUrl      String?         // URL of the product picture
  stockQuantity Int             @default(0)
  cities        City[]
  areas         Area[]
  areaDetails   ProductAreaDetail[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  orderItems    OrderItem[]
  reviews       Review[]

  @@index([categoryId])
}

model ProductAreaDetail {
  id              String   @id @default(uuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  areaId          String
  area            Area     @relation(fields: [areaId], references: [id], onDelete: Cascade)
  stockQuantity   Int      @default(0)
  locationUrl     String?
  videoUrl        String?
  message         String?
  cooldownMinutes Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  stockEntries    StockEntry[]

  @@unique([productId, areaId])
}

model StockEntry {
  id              String   @id @default(uuid())
  productAreaDetailId String
  productAreaDetail ProductAreaDetail @relation(fields: [productAreaDetailId], references: [id], onDelete: Cascade)
  quantity        Int      // Positive for additions, negative for removals
  type            String   // RESTOCK, SALE, ADJUSTMENT, DAMAGE, RETURN
  notes           String?
  createdBy       String?  // User ID who made the entry
  createdAt       DateTime @default(now())

  @@index([productAreaDetailId])
  @@index([createdAt])
}

model Order {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalAmount     Decimal        @default(0.0) @db.Decimal(12, 2)
  currency        String         @default("USD")
  status          String         @default("ORDERED") // ORDERED, PROCESSING, ON_PICKUP, COMPLETED, CANCELLED
  orderSource     String         @default("WEBSITE") // WEBSITE, TELEGRAM
  
  paymentMethod      String         @default("DIRECT_CRYPTO") // WALLET, DIRECT_CRYPTO
  cryptoCurrency     String?        // BTC, ETH, USDT_ERC20, USDT_TRC20, SOL, TRX
  cryptoAmountDue    String?        // Amount customer must send in chosen coin
  networkFee         Decimal?       @db.Decimal(12, 2) // Estimated network fee in USD
  paymentWalletAddress String?      // Specific address customer should pay to
  coinbaseChargeId   String?        
  coinbaseChargeUrl  String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  
  items              OrderItem[]
  disputes           Dispute[]

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id              String         @id @default(uuid())
  orderId         String
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceAtPurchase Decimal        @db.Decimal(12, 2)
  status          String         @default("ORDERED") // ORDERED, PROCESSING, ON_PICKUP, COMPLETED, CANCELLED
  cooldownEndAt   DateTime?
  
  adminMessage    String?
  adminMessageFileUrl  String? // Used for Photo
  adminMessageFileType String?
  adminMessageSentAt DateTime?
  automatedMessageSent Boolean @default(false)
  
  locationLink    String?
  pickupVideoUrl  String?
  cancellationReason String?
  onPickupAt      DateTime?       // When item entered ON_PICKUP (for 2-day auto-complete)

  areaId          String?
  area            Area?          @relation(fields: [areaId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([status])
}

model Dispute {
  id             String           @id @default(uuid())
  orderId        String
  order          Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason         String
  status         String           @default("OPEN") // OPEN, INVESTIGATING, RESOLVED
  resolutionType String?          // REFUND, CREDIT, REPLACEMENT, REJECTED
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  messages       DisputeMessage[]

  @@index([orderId])
  @@index([userId])
  @@index([status])
}

model DisputeMessage {
  id         String   @id @default(uuid())
  disputeId  String
  dispute    Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  senderRole String   // CUSTOMER or ADMIN
  senderName String
  message    String
  createdAt  DateTime @default(now())

  @@index([disputeId])
}

model Setting {
  id    String @id @default(uuid())
  key   String @unique
  value String
}

model DepositRequest {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount         Decimal  @db.Decimal(12, 2)
  cryptoCurrency String?  // BTC, ETH, USDT_ERC20, USDT_TRC20, SOL, TRX
  status         String   @default("PENDING") // PENDING, PROCESSING, APPROVED, REJECTED
  txHash         String?  // Transaction hash input by user
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model Review {
  id        String   @id @default(uuid())
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  text      String
  location  String?
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([userId])
}

model Coupon {
  id              String   @id @default(uuid())
  code            String   @unique
  description     String?
  discountType    String   // PERCENTAGE, FIXED_AMOUNT
  discountValue   Decimal  @db.Decimal(12, 2)
  minOrderAmount  Decimal? @db.Decimal(12, 2)
  maxDiscount     Decimal? @db.Decimal(12, 2) // For percentage discounts
  usageLimit      Int?     // Total number of times this coupon can be used
  usedCount       Int      @default(0)
  userLimit       Int?     // Per-user usage limit
  validFrom       DateTime @default(now())
  validUntil      DateTime?
  isActive        Boolean  @default(true)
  createdBy       String?  // Admin user ID
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  couponUsages    CouponUsage[]

  @@index([code])
  @@index([isActive])
}

model CouponUsage {
  id        String   @id @default(uuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    String
  orderId   String?
  discount  Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  @@index([couponId])
  @@index([userId])
  @@index([orderId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // ORDER_READY, ORDER_COMPLETED, ORDER_CANCELLED, GENERAL
  title     String
  message   String
  link      String?  // Optional link to order/product
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}
